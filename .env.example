# ---------------------------------------------------------------------------
# Plantilla de variables de entorno de Servipet.
# Copiar a `.env` y completar. `.env` esta en .gitignore, nunca commitear.
# ---------------------------------------------------------------------------

# --- Base de datos ----------------------------------------------------------
# SQLite local (dev). Produccion Neon: postgresql://user:pass@host/db?sslmode=require
# Neon tambien entrega postgres://... y la app lo normaliza sola.
DATABASE_URL=sqlite:///./servipet.db

APP_NAME=Servipet

# --- Modo de ejecucion ------------------------------------------------------
# true = desarrollo. false = produccion.
# En false la app NO arranca si falta SECRET_KEY o CORS_ORIGINS (fail-fast).
DEBUG=true

# --- Firma de JWT -----------------------------------------------------------
# Obligatoria con DEBUG=false. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotarla invalida todos los tokens emitidos.
# SECRET_KEY=

# --- CORS -------------------------------------------------------------------
# Origenes permitidos, separados por coma. Obligatoria con DEBUG=false.
# El front (Jinja + JS vanilla) se sirve desde la misma app, asi que en un
# despliegue normal alcanza con el propio dominio:
#   CORS_ORIGINS=https://servipet.onrender.com
# Con DEBUG=true se ignora esta variable y se permiten todos los origenes.
# CORS_ORIGINS=

# --- Seed Alpha (RBAC de 4 niveles) ------------------------------------------
# Leidas por scripts/seed_alpha.py (os.environ, NO forman parte de Settings).
# El script NO tiene defaults: si falta alguna, aborta sin tocar la BD.
# Correlativas: no pueden ser el mismo email.
#
# Nivel 1 - SuperAdmin: rol ADMIN con comercio_id NULL (acceso transversal).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Nivel 2 - Admin del comercio "Peluqueria Canina Huellas": rol ADMIN con comercio_id.
ALPHA_ADMIN_EMAIL=
ALPHA_ADMIN_PASSWORD=
# Nivel 3 - Empleado (staff): rol EMPLEADO con comercio_id.
ALPHA_EMPLEADO_EMAIL=
ALPHA_EMPLEADO_PASSWORD=
# Nivel 4 - Cliente: rol CLIENTE con comercio_id (+ fila Cliente vinculada).
ALPHA_CLIENTE_EMAIL=
ALPHA_CLIENTE_PASSWORD=
# Nombre del perfil Cliente (opcional, no es una credencial).
# ALPHA_CLIENTE_NOMBRE=
#
# passwords: maximo 72 bytes (limite de bcrypt).
# El 5to nivel (anonimo) no se siembra: no tiene registro en la BD.
#
# Seed opcional del dataset operativo (servicios, clientes, mascotas, turnos).
# Apagado por defecto para no meter agenda de prueba en produccion.
# SEED_ALPHA_DEMO=1

# --- Notificaciones de turnos ------------------------------------------------
# "log" (simulacion), "twilio" (WhatsApp/SMS) o "webhook" (HTTP POST)
NOTIFICATION_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# Con NOTIFICATION_PROVIDER=webhook se POSTea {destino, mensaje, evento, turno_id} a esta URL:
# NOTIFICATION_WEBHOOK_URL=https://tu-webhook.example.com/whatsapp
# NOTIFICATION_WEBHOOK_TIMEOUT_S=10
# NOTIFICATION_MAX_INTENTOS=3

# --- Solo Turso (SQLite persistente) -----------------------------------------
# URL tipo libsql://... y su token
# TURSO_AUTH_TOKEN=

# --- Cloudinary (fotos de la red comunitaria / avisos) -------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Chatbot IA con Gemini (Etapa 9.1) ---------------------------------------
# Key desde https://aistudio.google.com/apikey
# Sin GEMINI_API_KEY el endpoint /api/v1/chat responde en modo fallback amable.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_S=15