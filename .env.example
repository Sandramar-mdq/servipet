DATABASE_URL=sqlite:///./servipet.db
APP_NAME=Servipet
DEBUG=true
# SECRET_KEY=generar-con: python -c "import secrets; print(secrets.token_hex(32))"

# Notificaciones de turnos: "log" (simulacion), "twilio" (WhatsApp/SMS) o "webhook" (HTTP POST)
NOTIFICATION_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# Con NOTIFICATION_PROVIDER=webhook se POSTea {destino, mensaje, evento, turno_id} a esta URL:
# NOTIFICATION_WEBHOOK_URL=https://tu-webhook.example.com/whatsapp
# NOTIFICATION_WEBHOOK_TIMEOUT_S=10
# NOTIFICATION_MAX_INTENTOS=3

# Solo si usas Turso (SQLite persistente): URL tipo libsql://... y su token
# TURSO_AUTH_TOKEN=

# Cloudinary (fotos de la red comunitaria / avisos)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Chatbot IA con Gemini (Etapa 9.1): key desde https://aistudio.google.com/apikey
# Sin GEMINI_API_KEY el endpoint /api/v1/chat responde en modo fallback amable.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_S=15
